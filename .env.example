# ───────────────────────────────────────────────────────────────────────────
# WhoopNess environment — copy to .env.local and fill in. NEVER commit .env.local.
# All of these are SERVER-ONLY. Do not prefix any secret with NEXT_PUBLIC_.
# ───────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
# Single allowlisted user — only this Google email may sign in.
ALLOWED_USER_EMAIL=nissimguez2@gmail.com

# WHOOP developer app (https://developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a Redirect URL registered in the WHOOP app:
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
# Scopes (space-separated). `offline` is required for refresh tokens.
WHOOP_SCOPES=read:recovery read:cycles read:sleep read:workout read:profile read:body_measurement offline

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Model ids
ANTHROPIC_MODEL_PLAN=claude-opus-4-8
ANTHROPIC_MODEL_DAILY=claude-sonnet-4-6
ANTHROPIC_MODEL_TRIVIAL=claude-haiku-4-5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — full access, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key (base64) used to envelope-encrypt WHOOP tokens & sensitive fields at rest.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Google OAuth is configured in the Supabase dashboard (Auth > Providers > Google).
